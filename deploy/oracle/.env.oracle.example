# Copia este archivo como .env.oracle en la instancia. Escribe valores sin comillas.
DB_URL=jdbc:mysql://REEMPLAZAR_HOST_TIDB:4000/controlprendario?sslMode=VERIFY_IDENTITY&readOnlyPropagatesToServer=false
DB_USERNAME=
DB_PASSWORD=

# Clave aleatoria de al menos 32 bytes. Ejemplo de generación: openssl rand -hex 32
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Opcional. Completa ambos valores para habilitar la cuenta de empleado.
OPERATOR_USERNAME=
OPERATOR_PASSWORD=

# Usa el esquema existente de TiDB, que contiene IDs de tipos anteriores.
DDL_AUTO=none
