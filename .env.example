# Copia este archivo a .env en la raíz del backend.
# Usa valores sin comillas. Aplica al perfil local.

LOCAL_DB_URL=jdbc:mysql://localhost:3306/controlprendario?createDatabaseIfNotExist=true
LOCAL_DB_USERNAME=root
DB_PASSWORD=

# Descomenta y usa una clave aleatoria de al menos 32 bytes para conservar sesiones al reiniciar.
# LOCAL_JWT_SECRET=

# Define un usuario y su contraseña para cada cuenta local que vayas a usar.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# OPERATOR_USERNAME=
# OPERATOR_PASSWORD=
